# =============================================================================
# Flash 62 — variables d'environnement
# Copiez ce fichier en .env.local (jamais commité) et renseignez les valeurs.
# =============================================================================

# --- Application -------------------------------------------------------------
# URL publique du site (sans slash final). Utilisée pour les liens magiques,
# les notifications et les e-mails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Domaines e-mail autorisés à se connecter, séparés par des virgules.
# À garder aligné avec app_settings.allowed_email_domains en base.
ALLOWED_EMAIL_DOMAINS=sdis62.fr

# --- Supabase ----------------------------------------------------------------
# Dashboard Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé "anon" (ou clé "publishable" sb_publishable_… sur les projets récents)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé "service_role" : SERVEUR UNIQUEMENT, contourne la RLS. Jamais côté client.
SUPABASE_SERVICE_ROLE_KEY=

# --- SSO (optionnel, point d'extension) --------------------------------------
# AUTH_OIDC_PROVIDER=azure
# AUTH_OIDC_TENANT=

# --- Stockage S3 (lot c) -----------------------------------------------------
# Scaleway : S3_ENDPOINT=https://s3.fr-par.scw.cloud  S3_REGION=fr-par
# Cloudflare R2 : S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com  S3_REGION=auto
S3_ENDPOINT=
S3_BUCKET=flash62-media
S3_REGION=fr-par
S3_ACCESS_KEY=
S3_SECRET_KEY=
# URL publique de lecture du bucket (CDN ou domaine personnalisé), sans slash final
S3_PUBLIC_URL=
NEXT_PUBLIC_S3_PUBLIC_URL=

# --- Notifications (lot g) ---------------------------------------------------
# Générer avec : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:communication@sdis62.fr

# Digest e-mail : Resend (recommandé) ou SMTP
RESEND_API_KEY=
EMAIL_FROM="Flash 62 <noreply@sdis62.fr>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Secret partagé pour les routes /api/cron/* (pg_net et Vercel Cron)
CRON_SECRET=
